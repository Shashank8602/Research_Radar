# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Feedback links (Phase 2): HMAC key shared with the Cloudflare Worker, and the Worker's public URL
FEEDBACK_SIGNING_SECRET=
FEEDBACK_BASE_URL=https://research-radar-feedback.<your-subdomain>.workers.dev
# Used only by the Worker (set with `wrangler secret put`), kept here for reference
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Email: smtp (Gmail app password) or resend
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
RESEND_API_KEY=
