<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1c1e21;">
<div style="max-width:640px;margin:0 auto;padding:16px;">
  <div style="padding:8px 4px 6px;">
    <div style="font-size:22px;font-weight:700;">Research Radar</div>
    <div style="font-size:13px;color:#65676b;">{{ date }} &middot; {{ items|length }} things worth knowing today</div>
  </div>
  <div style="font-size:13px;color:#4b4f56;line-height:1.5;padding:0 4px 8px;">
    Each item says what it is in plain words, gives a quick &ldquo;imagine this&rdquo; example, and tells you why it matters.
    Tap a headline to read the original.
  </div>
  {% if degraded %}
  <div style="background:#fff4e5;border:1px solid #ffd8a8;border-radius:8px;padding:10px 12px;font-size:13px;margin:8px 0;">
    The AI summarizer was unavailable for some items, so those show the original technical text instead of a plain-English version.
  </div>
  {% endif %}
  {% for section in sections %}
  <div style="font-size:13px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#65676b;margin:22px 4px 8px;">{{ section.title }}</div>
  {% for it in section.entries %}
  <div style="background:#fff;border-radius:10px;padding:16px 18px;margin-bottom:12px;border:1px solid #e4e6eb;">
    <div style="font-size:12px;color:#65676b;margin-bottom:6px;">{{ it.kind }}{% if it.topic %} &middot; {{ it.topic }}{% endif %}</div>
    <div style="font-size:18px;font-weight:700;line-height:1.3;"><a href="{{ it.url }}" style="color:#0b57d0;text-decoration:none;">{{ it.headline }}</a></div>
    <div style="font-size:15px;line-height:1.55;margin-top:8px;">{{ it.summary }}</div>
    {% if it.example %}
    <div style="background:#eef4ff;border-left:4px solid #0b57d0;border-radius:4px;padding:10px 12px;margin-top:10px;font-size:14px;line-height:1.55;">
      <strong>Example:</strong> {{ it.example }}
    </div>
    {% endif %}
    <div style="font-size:15px;line-height:1.55;margin-top:10px;"><strong>Why it matters:</strong> {{ it.why_it_matters }}</div>
    {% if it.original_title %}
    <div style="font-size:11px;color:#8a8d91;margin-top:10px;">Original title: {{ it.original_title }}</div>
    {% endif %}
    {% if it.links %}
    <div style="margin-top:14px;padding-top:12px;border-top:1px solid #eef0f3;">
      {% if it.links.deepdive %}<a href="{{ it.links.deepdive }}" style="display:inline-block;margin:0 6px 6px 0;padding:7px 14px;border:1px solid #0b57d0;border-radius:999px;background:#ffffff;color:#0b57d0;font-size:13px;font-weight:600;text-decoration:none;">Explain in depth</a>{% endif %}
      {% if it.links.up %}<a href="{{ it.links.up }}" style="display:inline-block;margin:0 6px 6px 0;padding:7px 14px;border:1px solid #0b57d0;border-radius:999px;background:#0b57d0;color:#ffffff;font-size:13px;font-weight:600;text-decoration:none;">More like this</a>{% endif %}
      {% if it.links.down %}<a href="{{ it.links.down }}" style="display:inline-block;margin:0 6px 6px 0;padding:7px 14px;border:1px solid #c4c7cc;border-radius:999px;background:#ffffff;color:#4b4f56;font-size:13px;font-weight:600;text-decoration:none;">Less like this</a>{% endif %}
      {% if it.links.save %}<a href="{{ it.links.save }}" style="display:inline-block;margin:0 6px 6px 0;padding:7px 14px;border:1px solid #c4c7cc;border-radius:999px;background:#ffffff;color:#4b4f56;font-size:13px;font-weight:600;text-decoration:none;">Save for later</a>{% endif %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
  {% if not sections %}
  <div style="background:#fff;border-radius:10px;padding:16px;border:1px solid #e4e6eb;">Nothing cleared the bar today.</div>
  {% endif %}
  {% if has_deepdive %}<div style="font-size:12px;color:#8a8d91;text-align:center;margin-top:16px;">"Explain in depth" may take about 30 seconds to open the first time.</div>{% endif %}
  <div style="font-size:11px;color:#8a8d91;text-align:center;margin-top:20px;">Run {{ run_id }}</div>
</div>
</body>
</html>
