<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1c1e21;">
<div style="max-width:640px;margin:0 auto;padding:16px;">
  <div style="padding:8px 4px 16px;">
    <div style="font-size:22px;font-weight:700;">Research Radar</div>
    <div style="font-size:13px;color:#65676b;">{{ date }} · {{ items|length }} items{% if degraded %} · degraded mode{% endif %}</div>
  </div>
  {% if degraded %}
  <div style="background:#fff4e5;border:1px solid #ffd8a8;border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:12px;">
    The LLM judge was unavailable for some items, so they are ranked by topic match only and marked as unscored.
  </div>
  {% endif %}
  {% for section in sections %}
  <div style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#65676b;margin:20px 4px 8px;">{{ section.title }}</div>
  {% for it in section.entries %}
  <div style="background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:10px;border:1px solid #e4e6eb;">
    <div style="font-size:16px;font-weight:600;line-height:1.3;"><a href="{{ it.url }}" style="color:#0b57d0;text-decoration:none;">{{ it.title }}</a></div>
    <div style="font-size:12px;color:#65676b;margin:4px 0 8px;">{{ it.source }}{% if it.best_topic %} · {{ it.best_topic }}{% endif %}{% if it.scores %} · {{ it.scores }}{% endif %}</div>
    <div style="font-size:14px;line-height:1.5;">{{ it.summary }}</div>
    <div style="font-size:14px;line-height:1.5;margin-top:6px;"><strong>Why it matters:</strong> {{ it.why_it_matters }}</div>
    {% if it.links %}
    <div style="font-size:13px;margin-top:10px;">
      <a href="{{ it.links.up }}" style="text-decoration:none;margin-right:12px;">👍</a>
      <a href="{{ it.links.down }}" style="text-decoration:none;margin-right:12px;">👎</a>
      <a href="{{ it.links.deepdive }}" style="color:#0b57d0;text-decoration:none;">Deep dive</a>
    </div>
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
  {% if not sections %}
  <div style="background:#fff;border-radius:10px;padding:16px;border:1px solid #e4e6eb;">Nothing cleared the bar today.</div>
  {% endif %}
  <div style="font-size:11px;color:#8a8d91;text-align:center;margin-top:20px;">Run {{ run_id }}</div>
</div>
</body>
</html>
